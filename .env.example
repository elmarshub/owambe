# Copy this file to .env.local and fill it in. Never commit .env.local.
# With nothing filled in, the store runs in demo mode (fake sign-in and payment), like the prototype.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres for orders (Prisma). Supabase → Connect → ORMs → Prisma. Server only.
# Pooled connection (port 6543), used by the app at runtime.
DATABASE_URL=
# Direct or session connection (port 5432), used by `pnpm db:migrate`. Not needed on Netlify.
DIRECT_URL=

# Paystack → Settings → API Keys & Webhooks (keep the dashboard in Test mode).
# Leave both empty until you have them: any value here switches on live test payments.
# Public key, starts with pk_test_
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Secret key, starts with sk_test_. Server only.
PAYSTACK_SECRET_KEY=

# Where the site lives (used for links and share previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
