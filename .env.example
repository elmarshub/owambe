# Copy this file to .env.local and fill it in. Never commit .env.local.
# With nothing filled in, the store runs in demo mode (fake sign-in and payment), like the prototype.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security, used to write orders. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack → Settings → API Keys & Webhooks (keep the dashboard in Test mode)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_
# Server only.
PAYSTACK_SECRET_KEY=sk_test_

# Where the site lives (used for links and share previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
